# Variables para Docker Compose (copia este archivo a ".env" en esta misma carpeta).

# Obligatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Administrador inicial (se crea al primer arranque si no existe). Cambia la contraseña después de entrar.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=

# Puerto donde se abre la aplicación: http://localhost:8080
WEB_PORT=8080

# Desfase horario del negocio respecto a UTC (Colombia: -5)
ZONA_OFFSET_HORAS=-5

# Orígenes autorizados de navegador (en producción, usar HTTPS y dominio real).
# En instalación local Docker, si se omite usa http://localhost:8080; si cambias WEB_PORT, ajusta CORS_ORIGINS.
# CORS_ORIGINS=https://inventario.tuempresa.com
